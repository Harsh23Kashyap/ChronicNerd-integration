# Copy to .env and fill in. Never commit .env.

# --- Database (docker compose overrides host/port/user for its own MySQL) ---
host=127.0.0.1
port=3306
user=root
password=dietnerd
database=chronicnerd

# --- Research pipeline ---
OPENAI_API_KEY=
NCBI_API_KEY=
ENTREZ_EMAIL=
ELSEVIER_API_KEY=
SPRINGER_API_KEY=
WILEY_CLIENT_TOKEN=

# --- Web / sessions ---
# Comma-separated origins allowed to call the API with cookies.
ALLOWED_ORIGINS=http://localhost:8080
# Base URL used in password-reset links.
PUBLIC_SITE_URL=http://localhost:8080
# Set COOKIE_SECURE=1 once the site is served over HTTPS.
COOKIE_SECURE=0
COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=168
RESET_TTL_MINUTES=30
MAX_UPLOAD_MB=5

# --- Password-reset mail ---
# MAIL_BACKEND=ses|smtp|log. Leave empty to auto-pick; with nothing set the
# reset link is only written to the API log (fine for local testing).
MAIL_BACKEND=
MAIL_FROM=
# Amazon SES: MAIL_FROM must be a verified SES identity. Credentials come
# from the usual AWS chain (these vars, a profile, or an instance role).
AWS_SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# SMTP alternative
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
